# Environment
ENVIRONMENT=development
FRONTEND_URL=http://localhost:5173

# Database (NeonDB)
# Example: postgresql+asyncpg://user:password@ep-cool-snowflake-123456.us-east-2.aws.neon.tech/modifai?sslmode=require
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/modifai

# Google OAuth
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback

# JWT Authentication
SECRET_KEY=supersecretkey_please_change_in_production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Cloudflare R2
R2_ACCOUNT_ID=your-account-id
R2_ACCESS_KEY_ID=your-access-key
R2_SECRET_ACCESS_KEY=your-secret-key
R2_BUCKET_NAME=modifai
R2_ENDPOINT_URL=https://your-account-id.r2.cloudflarestorage.com

# Redis / Celery
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1
